{
  "name": "opencode-run-server",
  "version": "0.3.0",
  "description": "OpenCode v2 plugin with a backwards-compatible /run HTTP API and native plugin RPC for bounded, non-interactive session runs.",
  "type": "module",
  "main": "./dist/plugin.js",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "files": [
    "dist/",
    "index.js",
    "rpc.js",
    "README.md"
  ],
  "scripts": {
    "check": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsgo --noEmit",
    "knip": "knip",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "bun run script/build.ts",
    "verify:package": "bun run test/e2e/package.ts"
  },
  "license": "MIT",
  "author": "ysm-dev <i@ysm.dev>",
  "homepage": "https://github.com/ysm-dev/opencode-run-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysm-dev/opencode-run-server.git"
  },
  "bugs": {
    "url": "https://github.com/ysm-dev/opencode-run-server/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "tailscale",
    "run-server"
  ],
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@opencode/client": "2.0.4",
    "@opencode/plugin": "2.0.4",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@opencode/core": "2.0.4",
    "@opencode/schema": "2.0.4",
    "@opencode/sdk": "2.0.4",
    "@opencode/server": "2.0.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.12.4",
    "@typescript/native-preview": "^7.0.0-dev.20260602.1",
    "@vitest/coverage-v8": "^4.1.8",
    "effect": "4.0.0-rc.112",
    "knip": "^6.15.0",
    "vitest": "^4.1.8"
  }
}
