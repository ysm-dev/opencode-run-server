{
  "name": "opencode-run-server",
  "version": "0.0.3",
  "description": "opencode plugin that supervises a Hono HTTP subprocess exposing POST /run to trigger non-interactive `opencode run --attach` invocations against the same opencode server.",
  "type": "module",
  "main": "./dist/plugin.js",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "check": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsgo --noEmit",
    "knip": "knip",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "bun build src/plugin.ts src/server.ts --outdir dist --target node"
  },
  "license": "MIT",
  "author": "ysm-dev <i@ysm.dev>",
  "homepage": "https://github.com/ysm-dev/opencode-run-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysm-dev/opencode-run-server.git"
  },
  "bugs": {
    "url": "https://github.com/ysm-dev/opencode-run-server/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "hono",
    "tailscale",
    "run-server"
  ],
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@opencode-ai/plugin": "1.15.13",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.12.4",
    "@typescript/native-preview": "^7.0.0-dev.20260602.1",
    "@vitest/coverage-v8": "^4.1.8",
    "knip": "^6.15.0",
    "vitest": "^4.1.8"
  }
}
