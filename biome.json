{
  "$schema": "https://biomejs.dev/schemas/2.3.12/schema.json",
  "files": {
    "includes": [
      "*.json",
      "*.ts",
      "src/**/*.ts",
      "test/**/*.ts",
      ".github/**/*.yml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 150 }
        },
        "noExcessiveCognitiveComplexity": "error"
      },
      "nursery": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 300 }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  }
}
